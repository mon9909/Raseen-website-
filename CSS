:root {
  --navy: #243746;
  --navy-light: #304a5a;
  --sand: #c9b898;
  --gold: #b69a6d;
  --ivory: #f4eee7;
  --white: #fffdf9;
  --ink: #25343c;
  --muted: #69777c;
  --line: rgba(36,55,70,.16);
  --max: 1200px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body {
  margin: 0;
  background: var(--white);
  color: var(--ink);
  font-family: "Noto Sans Arabic", sans-serif;
  line-height: 1.85;
}
body[dir="ltr"] { font-family: Inter, sans-serif; }
a { text-decoration: none; color: inherit; }
img { display: block; width: 100%; object-fit: cover; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
.header {
  position: sticky; top: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  gap: 20px; padding: 14px max(24px, calc((100% - var(--max))/2));
  background: rgba(255,253,249,.96); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.brand strong { display: block; font: 700 23px Inter, sans-serif; letter-spacing: 3px; color: var(--navy); }
.brand small { display: block; font-size: 10px; color: var(--muted); }
.mark { display: flex; align-items: end; gap: 4px; height: 34px; }
.mark i { display: block; width: 8px; background: var(--gold); }
.mark i:nth-child(1) { height: 21px; }
.mark i:nth-child(2) { height: 32px; }
.mark i:nth-child(3) { height: 26px; }
nav { display: flex; gap: 20px; align-items: center; }
nav a { font-size: 12px; font-weight: 600; color: #43545d; }
nav a:hover { color: var(--gold); }
.language, .menu {
  border: 1px solid var(--line); background: transparent;
  padding: 8px 12px; color: var(--navy);
}
.menu { display: none; }

.hero {
  min-height: 650px; position: relative; display: flex; flex-direction: column;
  justify-content: center; color: white; padding: 90px max(24px, calc((100% - var(--max))/2));
  background: var(--navy) url("https://images.unsplash.com/photo-1736531679150-2884db2eed4e?auto=format&fit=crop&w=2000&q=85") center/cover no-repeat;
}
.hero-shade {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(24,42,54,.93), rgba(24,42,54,.65));
}
body[dir="rtl"] .hero-shade {
  background: linear-gradient(270deg, rgba(24,42,54,.93), rgba(24,42,54,.65));
}
.hero-content { max-width: 740px; position: relative; z-index: 1; }
.eyebrow {
  display: inline-block; color: var(--gold);
  font-size: 11px; font-weight: 700; letter-spacing: 2px;
}
.hero .eyebrow, .dark-section .eyebrow { color: var(--sand); }
h1, h2, h3 { line-height: 1.4; }
.hero h1 { font-size: clamp(40px, 6vw, 70px); font-weight: 500; margin: 20px 0; }
.hero h1 em { color: var(--sand); font-style: normal; }
.hero p { max-width: 620px; color: rgba(255,255,255,.8); }
.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 48px; padding: 12px 22px; border: 1px solid transparent;
  font-size: 12px; font-weight: 700; transition: .2s;
}
.primary { background: var(--sand); color: var(--navy); }
.primary:hover { background: #ddceb2; transform: translateY(-2px); }
.outline { border-color: rgba(255,255,255,.55); color: white; }
.outline:hover { background: white; color: var(--navy); }
.hero-bottom { position: absolute; bottom: 24px; inset-inline-start: max(24px, calc((100% - var(--max))/2)); color: rgba(255,255,255,.7); font-size: 11px; }

.section { padding: 95px max(24px, calc((100% - var(--max))/2)); }
.tinted { background: var(--ivory); }
.section-heading { max-width: 720px; margin-bottom: 38px; }
.section-heading h2, .intro-copy h2, .inquiry h2 { font-size: clamp(29px, 4vw, 43px); font-weight: 600; margin: 12px 0 18px; }
.section-heading p, .intro-copy p, .inquiry > div > p { color: var(--muted); font-size: 14px; max-width: 680px; }
#about { display: grid; grid-template-columns: 1fr 1fr; gap: 65px; align-items: center; }
.intro-image { min-height: 390px; }
.intro-image img { height: 390px; }
.principles { display: grid; grid-template-columns: repeat(3,1fr); gap: 15px; margin-top: 28px; }
.principles div { border-top: 1px solid var(--sand); padding-top: 12px; }
.principles strong, .principles small { display: block; }
.principles strong { font-size: 13px; }
.principles small { color: var(--muted); font-size: 11px; }

.grid { display: grid; gap: 1px; }
.services-grid { grid-template-columns: repeat(3,1fr); border: 1px solid var(--line); background: var(--line); }
.card { background: var(--white); padding: 27px; }
.card > span { color: var(--gold); font: 11px Inter, sans-serif; letter-spacing: 1px; }
.card h3 { margin: 20px 0 10px; font-size: 19px; }
.card p { color: var(--muted); font-size: 12px; margin-bottom: 0; }

.sector-grid { grid-template-columns: repeat(3,1fr); gap: 16px; }
.sector { min-height: 220px; position: relative; overflow: hidden; background: var(--navy); }
.sector img { height: 220px; opacity: .7; transition: .4s; }
.sector:hover img { transform: scale(1.05); }
.sector h3 { position: absolute; bottom: 10px; right: 20px; left: 20px; color: white; font-size: 20px; }

.dark-section { background: var(--navy); color: white; }
.dark-section .section-heading p { color: rgba(255,255,255,.7); }
.steps { grid-template-columns: repeat(5,1fr); gap: 24px; }
.steps article { border-top: 1px solid rgba(255,255,255,.35); padding-top: 18px; }
.steps article > span { color: var(--sand); font: 13px Inter, sans-serif; }
.steps h3 { margin: 18px 0 8px; font-size: 17px; }
.steps p { color: rgba(255,255,255,.65); font-size: 12px; }

.opportunity-grid { grid-template-columns: repeat(3,1fr); gap: 18px; }
.opportunity { border: 1px solid var(--line); }
.opportunity img { height: 200px; margin: -1px -1px 20px; width: calc(100% + 2px); }
.opportunity h3 { margin: 12px 0; }
.disclaimer, .privacy-note {
  padding: 15px 18px; background: var(--ivory);
  border-inline-start: 3px solid var(--sand); color: var(--muted); font-size: 12px;
  margin-top: 22px;
}
.inquiry { display: grid; grid-template-columns: .8fr 1.2fr; gap: 65px; }
.inquiry form { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; }
.inquiry label { display: flex; flex-direction: column; gap: 7px; font-size: 12px; font-weight: 600; }
.inquiry input, .inquiry select, .inquiry textarea {
  min-width: 0; width: 100%; padding: 12px; border: 1px solid var(--line);
  background: white; outline: none; border-radius: 0; color: var(--ink);
}
.inquiry input:focus, .inquiry select:focus, .inquiry textarea:focus { border-color: var(--gold); }
.inquiry textarea { min-height: 120px; resize: vertical; }
.full { grid-column: 1 / -1; }
.inquiry .consent { flex-direction: row; align-items: flex-start; color: var(--muted); font-weight: 400; }
.inquiry .consent input { width: auto; margin-top: 6px; }
#formMessage { font-size: 12px; color: var(--navy); }

footer { background: #1c2e3a; color: white; padding: 42px max(24px, calc((100% - var(--max))/2)) 20px; }
.footer-brand { display: flex; align-items: center; gap: 12px; }
.footer-brand strong { font: 700 22px Inter, sans-serif; letter-spacing: 3px; }
footer > p { font-size: 12px; color: rgba(255,255,255,.65); }
.footer-bottom { display: flex; justify-content: space-between; gap: 15px; border-top: 1px solid rgba(255,255,255,.18); padding-top: 17px; font-size: 10px; color: rgba(255,255,255,.55); }

@media (max-width: 1000px) {
  .header { padding-inline: 20px; }
  nav { gap: 10px; }
  nav a { font-size: 10px; }
  #about, .inquiry { gap: 35px; }
  .steps { grid-template-columns: repeat(3,1fr); }
}
@media (max-width: 760px) {
  .header { min-height: 70px; gap: 12px; }
  .menu { display: block; margin-inline-start: auto; }
  nav {
    display: none; position: absolute; top: 70px; inset-inline: 0;
    padding: 14px 22px; background: var(--white); border-bottom: 1px solid var(--line);
    align-items: stretch; flex-direction: column; gap: 0;
  }
  nav.open { display: flex; }
  nav a { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .brand strong { font-size: 19px; }
  .hero { min-height: 580px; padding: 75px 22px; }
  .hero h1 { font-size: 42px; }
  .section { padding: 65px 22px; }
  #about, .inquiry { grid-template-columns: 1fr; }
  .intro-image, .intro-image img { min-height: 270px; height: 270px; }
  .services-grid, .sector-grid, .opportunity-grid { grid-template-columns: 1fr; }
  .steps { grid-template-columns: 1fr 1fr; }
  .inquiry form { grid-template-columns: 1fr; }
  .full { grid-column: auto; }
  .footer-bottom { flex-direction: column; }
}
@media (max-width: 400px) {
  .steps { grid-template-columns: 1fr; }
  .language { padding: 7px 9px; }
}
